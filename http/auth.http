Content-Type: application/json

{
  "refreshToken": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmNzYxYjBlYzYzNjc0Yjg5YjhkYWQ1YmE5NGI5OGM0NSIsInJvbGUiOiJST0xFX1NZUyIsImlhdCI6MTc2OTg2NjY1MSwiZXhwIjoxNzcxMDc2MjUxLCJ0ZW5hbnRfaWQiOjEsInV1aWQiOiJmNzYxYjBlYzYzNjc0Yjg5YjhkYWQ1YmE5NGI5OGM0NSIsIm5hbWUiOiJzeXMyIn0.oz4DzA9csCoW0dIjhOeLG-BtUJ1vPIKEXc4i6Zz6BYQ"
