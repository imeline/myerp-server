@base = {{host}}/user/stock

### 재고 목록 조회
GET {{base}}?name=의&category=MERCHANDISE&warehouse=A창고&availableQuantityFrom=0&availableQuantityTo=1000&sortBy=AVAILABLE&page=0&size=20
Authorization: {{accessToken}}

### 단일 품목 재고/단가 조회
GET {{base}}/5
Authorization: {{accessToken}}

### 재고 변동 내역 조회(팝업)
GET {{base}}/5/movement?period=ALL&status=ALL&page=0&size=20
Authorization: {{accessToken}}

### 재고 현황 요약 조회
GET {{base}}/summary
Authorization: {{accessToken}}
Content-Type: application/json